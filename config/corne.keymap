#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define STRINGIFY(x) #x
#define EXPAND_AND_STRINGIFY(x) STRINGIFY(x)
#define MACRO(NAME, BINDINGS) \
mcr_##NAME: mcr_##NAME { \
   label = EXPAND_AND_STRINGIFY(mcr_##NAME); \
   compatible = "zmk,behavior-macro"; \
   #binding-cells = <0>; \
   wait-ms = <20>; \
   tap-ms = <10>; \
   bindings = <BINDINGS>; \
}

#define hands(layer_name, \
   lt1, lt2, lt3, lt4, lt5, lt6, lm1, lm2, lm3, lm4, lm5, lm6, lb1, lb2, lb3, lb4, lb5, lb6, lth1, lth2, lth3, \
   rt1, rt2, rt3, rt4, rt5, rt6, rm1, rm2, rm3, rm4, rm5, rm6, rb1, rb2, rb3, rb4, rb5, rb6, rth1, rth2, rth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      lt1 lt2 lt3 lt4 lt5 lt6 rt1 rt2 rt3 rt4 rt5 rt6 lm1 lm2 lm3 lm4 lm5 lm6 \
      rm1 rm2 rm3 rm4 rm5 rm6 lb1 lb2 lb3 lb4 lb5 lb6 rb1 rb2 rb3 rb4 rb5 rb6 \
      lth1 lth2 lth3 rth1 rth2 rth3 \
   >; \
}

#define right(layer_name, \
   rt1, rt2, rt3, rt4, rt5, rt6, rm1, rm2, rm3, rm4, rm5, rm6, rb1, rb2, rb3, rb4, rb5, rb6, rth1, rth2, rth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      &trans &trans &trans &trans &trans &trans rt1 rt2 rt3 rt4 rt5 rt6 \
      &trans &trans &trans &trans &trans &trans rm1 rm2 rm3 rm4 rm5 rm6 \
      &trans &trans &trans &trans &trans &trans rb1 rb2 rb3 rb4 rb5 rb6 \
      &trans &trans &trans rth1 rth2 rth3 \
   >; \
}

#define left(layer_name, \
   lt1, lt2, lt3, lt4, lt5, lt6, lm1, lm2, lm3, lm4, lm5, lm6, lb1, lb2, lb3, lb4, lb5, lb6, lth1, lth2, lth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      lt1 lt2 lt3 lt4 lt5 lt6 &trans &trans &trans &trans &trans &trans \
      lm1 lm2 lm3 lm4 lm5 lm6 &trans &trans &trans &trans &trans &trans \
      lb1 lb2 lb3 lb4 lb5 lb6 &trans &trans &trans &trans &trans &trans \
      lth1 lth2 lth3 &trans &trans &trans \
   >; \
}

#define base         0
#define remap_rh_1   1
#define remap_lh_1   2
#define term_1       3
#define term_2       4
#define code_1       5
#define code_2       6
#define symb_1       7
#define symb_2       8
#define os_1         9
#define os_2         10
#define cmd_1        11
#define macro_1      12
#define macro_2      13
#define numpad_1     14
#define numpad_2     15
// #define arrows_1  15
// #define arrows_2  16

/ {

   behaviors {
      mtp: mod_tap_preferred {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;
         flavor = "tap-preferred";
         tapping-term-ms = <200>;
         bindings = <&kp>, <&kp>;
         display-name = "Mod-Tap-Preferred";
      };
      space_colon_morph: space_colon_morph {
         compatible = "zmk,behavior-mod-morph";
         #binding-cells = <0>;
         bindings = <&kp SPACE>, <&kp COLON>;
         mods = <(MOD_LSFT | MOD_RSFT)>;
      };
   };

   macros {
      MACRO(zmk, &macro_press &kp LSHFT &macro_tap &kp Z &kp M &kp K &macro_release &kp LSHFT);
      MACRO(shift_tab, &macro_press &kp LSHFT &macro_tap &kp TAB &macro_release &kp LSHFT);
   };

   keymap {

      compatible = "zmk,keymap";

      hands( base_layer,

         &kp TAB,         &lt os_1 Q,        &kp W,              &mtp LGUI E,    &kp R,          &kp T,
         &mt LCTRL ESC,   &lt remap_rh_1 A,  &lt term_1 S,       &lt code_2 D,   &lt code_1 F,   &kp G,
         &sk LSHIFT,      &kp Z,             &kp X,              &kp C,          &lt numpad_1 V, &kp B,
         &kp SPACE,       &kp SPACE,      &kp SPACE,
         // &none,           &none,             &none,
         // &none,           &kp SPACE,      &none,
         // &kp LGUI,        &kp SPACE,      &kp LALT,

         &kp Y,           &kp U,          &mtp LGUI I,       &kp O,         &kp P,               &none,
         &kp H,           &kp J,          &lt remap_lh_1 K,  &kp L,         &space_colon_morph,  &kp RET,
         &kp N,           &kp M,          &kp COMMA,         &kp DOT,       &kp FSLH,            &none,
         &kp SPACE,       &kp SPACE,      &kp SPACE
         // &none,           &none,          &none
         // &kp SPACE,       &none,          &none
         // &none,           &none,          &none
         // &kp SPACE,       &ctrlentbspc,   &kp RGUI

         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans*/

      );

      right( remap_rh_1,
         &none,           &none,           &none,          &none,             &kp COLON,       &none,
         &none,           &kp BSPC,        &kp RET,        &kp SINGLE_QUOTE,  &kp SEMI,        &none,
         &kp LEFT,        &kp DOWN,        &kp UP,         &kp RIGHT,         &kp BSLH,        &none,
         &trans,          &trans,          &trans
      );

      left( remap_lh_1,
         &none,           &none,           &none,             &none,             &kp COLON,       &none,
         &none,           &kp SEMI,        &kp SINGLE_QUOTE,  &kp RET,           &kp BSPC,        &none,
         &kp LEFT,        &kp DOWN,        &kp UP,            &kp RIGHT,         &kp BSLH,        &none,
         &trans,          &trans,          &trans
      );

      right( term_1_layer,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &kp TILDE,        &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( term_2_layer,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &kp TILDE,        &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( code_1_layer,
         &none,            &none,           &kp LPAR,        &kp RPAR,       &kp CARET,       &none,
         &kp PLUS,         &kp UNDER,       &kp LBRC,        &kp RBRC,       &kp STAR,        &none,
         &kp MINUS,        &kp EQUAL,       &kp LBKT,        &kp RBKT,       &kp DOLLAR,      &mcr_zmk,
         &trans,           &trans,          &trans
      );

      right( code_2_layer,
         &none,            &kp PLUS,           &kp AMPS,            &kp PIPE,         &none,           &none,
         &none,            &kp GRAVE,          &kp DOUBLE_QUOTES,   &kp SINGLE_QUOTE, &kp STAR,        &none,
         &none,            &kp EQUAL,          &kp AT,              &kp HASH,         &kp FSLH,        &none,
         &trans,           &trans,             &trans
      );

      right( symb_1_layer,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &none,            &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( symb_2_layer,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &none,            &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( os_1_layer,
         &none,           &kp C_MUTE,      &kp C_VOL_DN,   &kp C_VOL_UP,    &none,  &studio_unlock,
         &none,           &kp C_PREV,      &kp C_PP,       &kp C_NEXT,      &none,           &none,
         &none,           &none,           &kp C_BRI_DN,   &kp C_BRI_UP,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( os_2_layer,
         &none,           &none,           &none,      &none,    &none,           &none,
         &none,           &none,           &none,      &none,    &none,           &none,
         &none,           &none,           &none,      &none,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( cmd_1_layer,
         &none,           &none,           &none,            &none,    &none,           &none,
         &none,           &mcr_shift_tab,  &kp TAB,          &none,    &none,           &none,
         &none,           &none,           &none,            &none,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( macro_1_layer,
         &none,           &kp C_MUTE,      &kp C_VOL_DN,   &kp C_VOL_UP,    &none,           &none,
         &none,           &kp C_PREV,      &kp C_PP,       &kp C_NEXT,      &none,           &none,
         &none,           &none,           &kp C_BRI_DN,   &kp C_BRI_UP,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( macro_2_layer,
         &none,           &kp C_MUTE,      &kp C_VOL_DN,   &kp C_VOL_UP,    &none,           &none,
         &none,           &kp C_PREV,      &kp C_PP,       &kp C_NEXT,      &none,           &none,
         &none,           &none,           &kp C_BRI_DN,   &kp C_BRI_UP,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( numpad_1_layer,
         &kp DOLLAR,      &kp N7,          &kp N8,          &kp N9,         &kp EQUAL,       &none,
         &kp PLUS,        &kp N4,          &kp N5,          &kp N6,         &trans,          &kp PRCNT,
         &kp MINUS,       &kp N1,          &kp N2,          &kp N3,         &kp FSLH,        &kp DOT,
         &kp N0,          &trans,          &trans
      );

      right( numpad_2_layer,
         &kp DOLLAR,      &kp N7,          &kp N8,          &kp N9,         &kp EQUAL,       &none,
         &kp PLUS,        &kp N4,          &kp N5,          &kp N6,         &trans,          &kp PRCNT,
         &kp MINUS,       &kp N1,          &kp N2,          &kp N3,         &kp FSLH,        &kp DOT,
         &kp N0,          &trans,          &trans
      );

      // right( arrows_1_layer,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &kp LEFT,        &kp DOWN,        &kp UP,         &kp RIGHT,       &none,           &none,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &trans,          &trans,          &trans
      // );

      // right( arrows_2_layer,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &kp LEFT,        &kp DOWN,        &kp UP,         &kp RIGHT,       &none,           &none,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &trans,          &trans,          &trans
      // )
   };

};
