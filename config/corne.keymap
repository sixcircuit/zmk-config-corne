#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define STRINGIFY(x) #x
#define EXPAND_AND_STRINGIFY(x) STRINGIFY(x)
#define MACRO(NAME, BINDINGS) \
mcr_##NAME: mcr_##NAME { \
   compatible = "zmk,behavior-macro"; \
   #binding-cells = <0>; \
   wait-ms = <20>; \
   tap-ms = <10>; \
   bindings = <BINDINGS>; \
}

#define hands(layer_name, \
   lt1, lt2, lt3, lt4, lt5, lt6, lm1, lm2, lm3, lm4, lm5, lm6, lb1, lb2, lb3, lb4, lb5, lb6, lth1, lth2, lth3, \
   rt1, rt2, rt3, rt4, rt5, rt6, rm1, rm2, rm3, rm4, rm5, rm6, rb1, rb2, rb3, rb4, rb5, rb6, rth1, rth2, rth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      lt1 lt2 lt3 lt4 lt5 lt6 rt1 rt2 rt3 rt4 rt5 rt6 lm1 lm2 lm3 lm4 lm5 lm6 \
      rm1 rm2 rm3 rm4 rm5 rm6 lb1 lb2 lb3 lb4 lb5 lb6 rb1 rb2 rb3 rb4 rb5 rb6 \
      lth1 lth2 lth3 rth1 rth2 rth3 \
   >; \
}

#define right(layer_name, \
   rt1, rt2, rt3, rt4, rt5, rt6, rm1, rm2, rm3, rm4, rm5, rm6, rb1, rb2, rb3, rb4, rb5, rb6, rth1, rth2, rth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      &trans &trans &trans &trans &trans &trans rt1 rt2 rt3 rt4 rt5 rt6 \
      &trans &trans &trans &trans &trans &trans rm1 rm2 rm3 rm4 rm5 rm6 \
      &trans &trans &trans &trans &trans &trans rb1 rb2 rb3 rb4 rb5 rb6 \
      &trans &trans &trans rth1 rth2 rth3 \
   >; \
}

#define left(layer_name, \
   lt1, lt2, lt3, lt4, lt5, lt6, lm1, lm2, lm3, lm4, lm5, lm6, lb1, lb2, lb3, lb4, lb5, lb6, lth1, lth2, lth3 \
) \
layer_name { \
   display-name = EXPAND_AND_STRINGIFY(layer_name); \
   bindings = < \
      lt1 lt2 lt3 lt4 lt5 lt6 &trans &trans &trans &trans &trans &trans \
      lm1 lm2 lm3 lm4 lm5 lm6 &trans &trans &trans &trans &trans &trans \
      lb1 lb2 lb3 lb4 lb5 lb6 &trans &trans &trans &trans &trans &trans \
      lth1 lth2 lth3 &trans &trans &trans \
   >; \
}

#define BASE         0
#define RERIGHT_1    1
#define RELEFT_1     2
#define TERM_1       3
#define TERM_2       4
#define CODE_1       5
#define CODE_2       6
#define SYMB_1       7
#define SYMB_2       8
#define OS_1         9
#define OS_2         10
#define CMD_1        11
#define MACRO_1      12
#define MACRO_2      13
#define NUMPAD_1     14
#define VIMNAV_1     15
#define ARROWS_1     16
// #define arrows_2  16

/ {

   behaviors {
      mts: mod_tap_safe {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;
         flavor = "tap-preferred";
         tapping-term-ms = <200>;
         bindings = <&kp>, <&kp>;
         require-prior-idle-ms = <125>;
         display-name = "Mod-Tap-Preferred";
      };
      space_colon_morph: space_colon_morph {
         compatible = "zmk,behavior-mod-morph";
         #binding-cells = <0>;
         bindings = <&kp SPACE>, <&kp COLON>;
         mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      ctrl_c: ctrl_c_morph {
         compatible = "zmk,behavior-mod-morph";
         #binding-cells = <0>;
         bindings = <&kp C>, <&kp LC(C)>;
         mods = <(MOD_LALT)>;
      };
      super_shift: super_shift {
         compatible = "zmk,behavior-tap-dance";
         #binding-cells = <0>;
         tapping-term-ms = <250>;
         bindings = <&sk RSHIFT>, <&caps_word>;
      };
      td0: tap_dance_0 {
         compatible = "zmk,behavior-tap-dance";
         #binding-cells = <0>;
         tapping-term-ms = <350>;
         bindings = <&kp N1>, <&kp N2>, <&kp SEMI>;
      };
      lqt: layer_quick_tap {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;
         flavor = "tap-preferred";
         tapping-term-ms = <250>;
         quick-tap-ms = <350>;
         bindings = <&mo>, <&kp>;
      };
      v_toggle_reright: v_toggle_reright {
         compatible = "zmk,behavior-tap-dance";
         #binding-cells = <0>;
         tapping-term-ms = <250>;
         bindings = <
            &lt RERIGHT_1 V
            &tog RERIGHT_1
         >;
      };
      tog_on: toggle_layer_on_only {
         compatible = "zmk,behavior-toggle-layer";
         #binding-cells = <1>;
         display-name = "Toggle Layer On";
         toggle-mode = "on";
      };
      tog_off: toggle_layer_off_only {
         compatible = "zmk,behavior-toggle-layer";
         #binding-cells = <1>;
         display-name = "Toggle Layer Off";
         toggle-mode = "off";
      };
   };

   macros {
      MACRO(zmk, &macro_press &kp LSHFT &macro_tap &kp Z &kp M &kp K &macro_release &kp LSHFT);
      MACRO(shift_tab, &macro_press &kp LSHFT &macro_tap &kp TAB &macro_release &kp LSHFT);
      MACRO(seq, &macro_tap &kp EQUAL &kp EQUAL &kp EQUAL);
      MACRO(sne, &macro_tap &kp EXCL &kp EQUAL &kp EQUAL);
      MACRO(lte, &macro_tap &kp LT &kp EQUAL);
      MACRO(gte, &macro_tap &kp GT &kp EQUAL);
      MACRO(gg, &macro_tap &kp G &kp G);
   };

   conditional_layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
         if-layers = <NUMPAD_1 TERM_1>;
         then-layer = <ARROWS_1>;
      };
   };
   // TODO: make some better symbol tables for coding. then wrap it up.

   keymap {

      compatible = "zmk,keymap";

      hands( base,

         &kp TAB      , &lt OS_1 Q     , &kp W           , &mts LGUI E   , &kp R           , &kp T            ,
         &mt LALT ESC , &lt NUMPAD_1 A , &lt TERM_1 S    , &lqt CODE_2 D , &lt CODE_1 F    , &kp G            ,
         &super_shift , &kp Z          , &kp X           , &ctrl_c       , &lt RERIGHT_1 V , &kp B            ,
         &kp SPACE    , &kp SPACE      , &kp SPACE       ,
         // &none     , &none          , &none           ,
         // &none     , &kp SPACE      , &none           ,
         // &kp LGUI  , &kp SPACE      , &kp LALT        ,

         &kp Y        , &kp U          , &mts LGUI I     , &kp O         , &kp P           , &tog_on VIMNAV_1 ,
         &kp H        , &lqt SYMB_1 J  , &lqt RELEFT_1 K , &kp L         , &kp SEMI        , &super_shift     ,
         &kp N        , &lt RELEFT_1 M , &kp COMMA       , &kp DOT       , &kp FSLH        , &none            ,
         &none        , &none          , &none
         // &kp SPACE , &kp SPACE      , &kp SPACE
         // &kp SPACE , &none          , &none
         // &none     , &none          , &none
         // &kp SPACE , &ctrlentbspc   , &kp RGUI

         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans,&trans,&trans,&trans,*/
         /*&trans,&trans,&trans*/

      );

      right( reright,
         &none  , &none     , &none     , &none     , &none    , &none ,
         &none  , &kp BSPC  , &kp RET   , &kp COLON , &kp SEMI , &none ,
         &none  , &kp LA(D) , &kp LA(U) , &none     , &kp BSLH , &none ,
         &trans , &trans    , &trans
      );

      left( releft,
         &none  , &none     , &none     , &none     , &none     , &none ,
         &none  , &kp LG(H) , &kp LA(H) , &kp LA(L) , &kp LG(L) , &none ,
         &none  , &none     , &none     , &none     , &none     , &none ,
         &trans , &trans    , &trans
      );

      right( term_1,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &kp TILDE,        &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( term_2,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &kp TILDE,        &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      right( code_1,
         &none,            &kp BSLH,        &kp LPAR,        &kp RPAR,       &kp CARET,       &none,
         &kp PLUS,         &kp UNDER,       &kp LBRC,        &kp RBRC,       &kp STAR,        &none,
         &kp MINUS,        &kp EQUAL,       &kp LBKT,        &kp RBKT,       &kp DOLLAR,      &mcr_zmk,
         &trans,           &trans,          &trans
      );

      right( code_2,
         &none,            &kp PLUS,           &kp AMPS,            &kp PIPE,         &none,           &none,
         &none,            &kp DOUBLE_QUOTES,  &kp GRAVE,           &kp SINGLE_QUOTE, &kp STAR,        &none,
         &none,            &kp EQUAL,          &kp AT,              &kp HASH,         &kp FSLH,        &none,
         &trans,           &trans,             &trans
      );

      // &macro_tap &kp EQUAL &kp EQUAL &kp EQUAL
      // &macro_tap &kp MINUS &kp GT                 // ->
      // &macro_tap &kp AMPERSAND &kp AMPERSAND      // &&

      left( symb_1,
         &none  , &none  , &mcr_lte , &mcr_gte , &none  , &none ,
         &none  , &kp LT , &mcr_sne , &mcr_seq , &kp GT , &none ,
         &none  , &none  , &none    , &none    , &none  , &none ,
         &trans , &trans , &trans
      );

      right( symb_2,
         &none,            &kp PLUS,        &kp AMPS,        &kp PIPE,       &none,           &none,
         &none,            &kp MINUS,       &kp EXCL,        &kp PRCNT,      &kp STAR,        &none,
         &none,            &kp EQUAL,       &kp AT,          &kp HASH,       &kp FSLH,        &none,
         &trans,           &trans,          &trans
      );

      hands( os_1,
         &bootloader , &trans     , &trans       , &trans       , &trans , &trans      ,
         &trans      , &trans     , &trans       , &trans       , &trans , &trans      ,
         &trans      , &trans     , &trans       , &trans       , &trans , &trans      ,
         &trans      , &trans     , &trans       ,

         &none       , &kp C_MUTE , &kp C_VOL_DN , &kp C_VOL_UP , &none  , &bootloader ,
         &none       , &kp C_PREV , &kp C_PP     , &kp C_NEXT   , &none  , &none       ,
         &none       , &none      , &kp C_BRI_DN , &kp C_BRI_UP , &none  , &none       ,
         &trans      , &trans     , &trans
      );

      right( os_2,
         &none,           &none,           &none,      &none,    &none,           &none,
         &none,           &none,           &none,      &none,    &none,           &none,
         &none,           &none,           &none,      &none,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( cmd_1,
         &none,           &none,           &none,            &none,    &none,           &none,
         &none,           &mcr_shift_tab,  &kp TAB,          &none,    &none,           &none,
         &none,           &none,           &none,            &none,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( macro_1,
         &none,           &kp C_MUTE,      &kp C_VOL_DN,   &kp C_VOL_UP,    &none,           &none,
         &none,           &kp C_PREV,      &kp C_PP,       &kp C_NEXT,      &none,           &none,
         &none,           &none,           &kp C_BRI_DN,   &kp C_BRI_UP,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( macro_2,
         &none,           &kp C_MUTE,      &kp C_VOL_DN,   &kp C_VOL_UP,    &none,           &none,
         &none,           &kp C_PREV,      &kp C_PP,       &kp C_NEXT,      &none,           &none,
         &none,           &none,           &kp C_BRI_DN,   &kp C_BRI_UP,    &none,           &none,
         &trans,          &trans,          &trans
      );

      right( numpad_1,
         &kp DOLLAR,      &kp N7,          &kp N8,          &kp N9,         &kp EQUAL,       &none,
         &kp PLUS,        &kp N4,          &kp N5,          &kp N6,         &trans,          &kp PRCNT,
         &kp MINUS,       &kp N1,          &kp N2,          &kp N3,         &kp FSLH,        &kp DOT,
         &kp N0,          &trans,          &trans
      );

      hands( vimnav_1,
         &none             , &none     , &none     , &none     , &none , &none             ,
         &tog_off VIMNAV_1 , &none     , &none     , &none     , &none , &none             ,
         &none             , &none     , &none     , &none     , &none , &none             ,
         &none             , &none     , &none     ,

         &none             , &none     , &mcr_gg   , &kp LS(G) , &none , &tog_off VIMNAV_1 ,
         &none             , &kp LA(D) , &kp LA(U) , &none     , &none , &none             ,
         &none             , &kp LA(J) , &kp LA(K) , &none     , &none , &none             ,
         &none             , &trans    , &trans
      );

      right( arrows_1,
         &none,           &none,           &none,          &none,          &none,           &none,
         &kp LEFT,        &kp DOWN,        &kp UP,         &kp RIGHT,      &none,           &none,
         &none,           &none,           &none,          &none,          &none,           &none,
         &trans,          &trans,          &trans
      );

      // right( arrows_2,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &kp LEFT,        &kp DOWN,        &kp UP,         &kp RIGHT,       &none,           &none,
         // &none,           &none,           &none,           &none,          &none,           &none,
         // &trans,          &trans,          &trans
      // )
   };

};
